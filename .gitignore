__pycache__/
*.py[cod]
.pytest_cache/
ablation_final.txt
eval_results.json
eval_results_reactive*.json
graphify-out/
demo_*.png
*.gif
# datasets and checkpoints stay out of the repo
data/
datasets/
# ...but divas/perception/datasets/ is *code* that loads them, not data. The
# bare `datasets/` rule above matches it at any depth, which silently dropped
# idd_polygons.py from a commit -- the file was written, staged, refused, and
# the commit succeeded without it.
!divas/perception/datasets/
# Only the source. A bare `**` here also negates the __pycache__ rule above,
# because later patterns win -- which committed three .pyc files.
!divas/perception/datasets/*.py
*.pth
*.pt
*.onnx
*.engine
# ROS 2 build products
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# The SIH deck carries the team roster: full names, registration numbers,
# email addresses and mobile numbers for six people. This repository is
# public, so it is deliberately not tracked here. Share it directly, or make
# the repository private first.
deck/
ablation_margin.txt

# Datasets must never enter this repository. The IDD segmentation archive
# alone is 18.5 GB, and GitHub's hard limit is 100 MB per file -- a single
# accidental `git add .` would wedge the repository irrecoverably.
*.tar.gz
*.tar
*.zip
IDD/
IDD_Segmentation/
idd-segmentation*

# Blender intermediate frames -- 526 PNGs at 1600x900 is ~300 MB and the MP4
# beside them is the artefact worth keeping.
demo/blender_frames/
demo/indian_drive/
demo/perception/
